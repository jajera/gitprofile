---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import ThemeToggle from '../components/ThemeToggle.astro';
import site from '../../site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const pageTitle = title === site.title ? `${site.title} · CV` : `${title} · ${site.brand}`;
const home = withBase();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase('og.png'), Astro.site);
const gaId =
  typeof site.gaMeasurementId === 'string' && /^G-[A-Z0-9]+$/i.test(site.gaMeasurementId)
    ? site.gaMeasurementId
    : '';
const enableAnalytics = import.meta.env.PROD && Boolean(gaId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#071014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={`${site.brand} CV`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${site.brand} CV`} />

    <title>{pageTitle}</title>
    {
      enableAnalytics && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {
          t = null;
        }
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=optional"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <svg class="sprite" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="i-auto" viewBox="0 0 24 24">
          <path
            d="M12 2v2M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715M16 12a4 4 0 0 0-4-4M19 5l-1.256 1.256M20 12h2"
          ></path>
        </symbol>
        <symbol id="i-light" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </symbol>
        <symbol id="i-dark" viewBox="0 0 24 24">
          <path
            d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
          ></path>
        </symbol>
      </defs>
    </svg>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={home}>{site.brand}</a>
        <div class="site-header__actions">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <nav class="site-nav" aria-label="Primary">
      <div class="site-nav__inner">
        <a href={home} aria-current="page">CV</a>
        <a href={site.links.projects} rel="noopener noreferrer">Projects</a>
        <a href={site.links.guides} rel="noopener noreferrer">Guides</a>
        <a href={site.links.home} rel="noopener noreferrer">johna.kiwi</a>
      </div>
    </nav>

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          <span class="brand-name">{site.brand}</span>
          · {site.author} ·
          <a href={site.links.home} rel="noopener noreferrer">johna.kiwi</a>
          ·
          <a href={site.links.projects} rel="noopener noreferrer">pages</a>
          ·
          <a href={site.links.guides} rel="noopener noreferrer">guides</a>
          ·
          <a href={site.links.repo}>GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
